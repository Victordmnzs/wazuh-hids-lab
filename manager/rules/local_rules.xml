<group name="trabalho_hids,local,">

  <!-- MODULO A: FIM -->

  <rule id="100001" level="15">
    <if_sid>550,553,554</if_sid>
    <field name="file">/etc/passwd</field>
    <description>CUSTOM CRITICO [R1]: Arquivo /etc/passwd foi modificado!</description>
    <group>ossec,syscheck,fim_critical,</group>
  </rule>

  <rule id="100002" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/tmp/\.|^/var/www/html/\.</field>
    <description>CUSTOM [R2]: Arquivo oculto criado em diretorio sensivel (possivel malware)</description>
    <group>ossec,syscheck,malware,</group>
  </rule>

  <rule id="100003" level="14">
    <if_sid>550,552</if_sid>
    <field name="file" type="pcre2">^/var/log/</field>
    <description>CUSTOM CRITICO [R3]: Arquivo de log deletado/modificado - Evasao de Defesa!</description>
    <group>ossec,syscheck,defense_evasion,</group>
  </rule>

  <rule id="100004" level="12">
    <if_sid>550,553</if_sid>
    <field name="file" type="pcre2">^/var/www/html/</field>
    <regex type="pcre2">777|rwxrwxrwx</regex>
    <description>CUSTOM [R4]: Permissao 777 detectada em arquivo de /var/www/html</description>
    <group>ossec,syscheck,fim_chmod,</group>
  </rule>

  <!-- MODULO B: Autenticacao -->

  <rule id="100005" level="12" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip/>
    <description>CUSTOM [R5]: Forca Bruta SSH - 5 falhas em 120s do mesmo IP</description>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <rule id="100006" level="10">
    <if_sid>5715</if_sid>
    <time>00:00-06:00</time>
    <description>CUSTOM [R6]: Login SSH bem-sucedido fora do horario comercial (00h-06h)</description>
    <group>authentication_success,anomaly_temporal,</group>
  </rule>

 <rule id="100007" level="10">
  <if_sid>5404</if_sid>
  <description>CUSTOM [R7]: 3 falhas consecutivas de sudo pelo mesmo usuario</description>
  <group>authentication_failures,privilege_abuse,</group>
 </rule>

  <!-- MODULO C: Web -->

  <rule id="100008" level="12">
    <if_group>accesslog</if_group>
    <regex type="pcre2">(?i)(\x27\s*(?:OR|AND)\s*\x27?1|UNION[\s+%20]+SELECT|--[\s+]|%27|%20(?:OR|AND)%20|1\s*=\s*1)</regex>
    <description>CUSTOM [R8]: SQL Injection detectado nos logs de acesso web</description>
    <group>attack,web,sql_injection,</group>
  </rule>

  <rule id="100009" level="12">
    <if_group>accesslog</if_group>
    <regex type="pcre2">(?i)(\.\.\/|\.\.\\|%2e%2e%2f|%2e%2e\/|\.\.%2f|%2e%2e%5c).{0,60}(?:etc/passwd|etc%2fpasswd)</regex>
    <description>CUSTOM [R9]: Tentativa de Path Traversal / LFI detectada</description>
    <group>attack,web,lfi,</group>
  </rule>

  <rule id="100010" level="12">
    <if_group>accesslog</if_group>
    <regex type="pcre2">(?i)(%3C|&lt;)script|javascript:|onerror\s*=|onload\s*=|alert\s*\(|document\.cookie</regex>
    <description>CUSTOM [R10]: Tentativa de Cross-Site Scripting (XSS) detectada</description>
    <group>attack,web,xss,</group>
  </rule>

  <rule id="100020" level="6">
    <program_name>kernel</program_name>
    <match>[UFW BLOCK]</match>
    <description>UFW: Pacote bloqueado pelo firewall</description>
    <group>firewall,ufw,</group>
  </rule>

  <rule id="100011" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100020</if_matched_sid>
    <same_source_ip/>
    <description>CUSTOM [R11]: Possivel varredura de portas (Port Scan) detectada</description>
    <group>attack,recon,portscan,</group>
  </rule>

</group>
